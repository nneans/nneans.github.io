{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mingyun-os-hit-counter",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "vars": {
    "ALLOWED_ORIGINS": "https://nneans.github.io,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mingyun-os-hits",
