{
  "name": "mingyun-os-96",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:check": "tsc -p worker/tsconfig.json && wrangler deploy --dry-run --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:migrate:local": "wrangler d1 migrations apply mingyun-os-hits --local --config worker/wrangler.jsonc",
    "worker:migrate:remote": "wrangler d1 migrations apply mingyun-os-hits --remote --config worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "happy-dom": "^20.11.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
